<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F9FC"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="20sp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Find People"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#172033"
            android:gravity="center" />

        <Space
            android:layout_width="48dp"
            android:layout_height="1dp" />

    </LinearLayout>

    <!-- Description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Find people by their username"
        android:textSize="15sp"
        android:textColor="#687386" />

    <!-- Search -->
    <EditText
        android:id="@+id/etSearchUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Enter username"
        android:inputType="text"
        android:singleLine="true"
        android:padding="14dp"
        android:background="#FFFFFF" />

    <!-- Search button -->
    <Button
        android:id="@+id/btnSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Search" />

    <!-- Result area -->
    <LinearLayout
        android:id="@+id/resultContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#FFFFFF"
        android:padding="18dp">

        <TextView
            android:id="@+id/tvResultName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rahim"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#172033" />

        <TextView
            android:id="@+id/tvResultUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@rahim123"
            android:textSize="15sp"
            android:textColor="#687386" />

        <Button
            android:id="@+id/btnAddFriend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Send Friend Request" />

    </LinearLayout>

    <!-- Message -->
    <TextView
        android:id="@+id/tvSearchMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text=""
        android:textSize="15sp"
        android:textColor="#687386"
        android:gravity="center" />

</LinearLayout>